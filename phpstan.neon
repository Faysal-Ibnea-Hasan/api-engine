includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7
    ignoreErrors:
        # Shapes are JSON-like arrays by design; their element types are checked by tests, not docblocks.
        -
            identifier: missingType.iterableValue
            path: app/Domain/Analysis/Shape/*
